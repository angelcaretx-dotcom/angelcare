# Copy to .env for local development.

# django-insecure key is used automatically when DEBUG=True and this is unset.
# In production this MUST be set to a real, secret, unique value.
DJANGO_SECRET_KEY=

DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Comma-separated. In production, set to the deployed frontend origin(s), e.g.
# https://www.angelcaretransit.com
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# postgres://USER:PASSWORD@HOST:PORT/DBNAME
#
# Recommended for local dev, to match production's PostgreSQL instead of
# testing against SQLite (run `docker compose up -d` from the repo root
# first, using the docker-compose.yml at the repo root):
# DATABASE_URL=postgresql://angelcare:localdev@localhost:5432/angelcare
#
# Left fully unset: falls back to SQLite when DJANGO_DEBUG=True (fine for
# a quick start, but not a substitute for testing against real Postgres
# before relying on Postgres-specific behavior).
DATABASE_URL=

DJANGO_SECURE_SSL_REDIRECT=True

# --- Email / Notifications ---
# Left unset locally: emails print to the runserver console (DEBUG=True
# default), no account or credentials needed. In production, set these
# to send real email -- any SMTP provider works (Gmail SMTP with an app
# password is a zero-new-signup option; a dedicated transactional
# provider like SendGrid/Postmark/SES scales and deliverability better).
DJANGO_EMAIL_BACKEND=
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL=angelcaretx@gmail.com
STAFF_NOTIFICATION_EMAIL=angelcaretx@gmail.com

# Absolute base URLs for links inside HTML emails (e.g. the "Review in
# Admin" button). Left unset: defaults to the real current production
# URLs when DJANGO_DEBUG=False, or localhost when it's True. Only need
# to set these if the domain ever changes.
DJANGO_SITE_URL=
DJANGO_WEBSITE_URL=
